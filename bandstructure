# Pad the Hamiltonian to the nearest 2^n x 2^n dimensions
def pad_to_nearest_power_of_two(matrix):
    N = int(np.ceil(np.log2(len(matrix))))
    padded_matrix = np.zeros((2**N, 2**N), dtype=complex)
    padded_matrix[:matrix.shape[0], :matrix.shape[1]] = matrix
    return padded_matrix

