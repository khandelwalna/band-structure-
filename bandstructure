len_k_points = []

# Calculate cumulative k-point distances
kpoints_track = 0.0
len_k_points.append(kpoints_track)
for i in range(1, len(kpoints)):
    k0 = kpoints[i-1]
    k1 = kpoints[i]
    dx = k0[0]-k1[0]
    dy = k0[1]-k1[1]
    dz = k0[2]-k1[2]
    kpoints_track += np.sqrt(dx**2 + dy**2 + dz**2)
    len_k_points.append(kpoints_track)

